<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Neon Arcade — Play with golds</title>
<style>
:root{--bg:#080711;--panel:#141222;--panel2:#1b1830;--purple:#9565ff;--pink:#e879f9;--gold:#ffc857;--text:#f8f5ff;--muted:#aaa4bd;--line:#302943}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#38205b 0,#120e20 38%,#080711 76%);color:var(--text);font:16px/1.45 system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
header{display:flex;align-items:center;justify-content:space-between;padding:16px max(4vw,16px);border-bottom:1px solid #ffffff16;background:#0b0914e8;position:sticky;top:0;backdrop-filter:blur(14px);z-index:5}
.logo{font-weight:950;letter-spacing:.09em;font-size:19px}.logo span{color:var(--pink)}.balance{background:linear-gradient(120deg,#28203e,#171326);border:1px solid #6e52a2;padding:9px 14px;border-radius:999px;font-weight:850;color:#f3e8ff;box-shadow:0 0 22px #8b5cf622}
main{width:min(1120px,92vw);margin:28px auto 70px}.hero{position:relative;overflow:hidden;padding:clamp(24px,5vw,44px);border:1px solid #5b417d;border-radius:26px;background:linear-gradient(115deg,#291b43,#171326 58%,#361b45);box-shadow:0 20px 65px #0007}
.hero:after{content:"✦";position:absolute;right:7%;top:5%;font-size:clamp(90px,18vw,180px);color:#ffffff0b;pointer-events:none}
.eyebrow{color:#e1c4ff;text-transform:uppercase;font-size:11px;font-weight:900;letter-spacing:.2em}h1{font-size:clamp(34px,6vw,58px);line-height:1.02;margin:12px 0}p{color:var(--muted);margin:8px 0}.hero p{max-width:540px;font-size:17px}.notice{display:inline-block;font-size:12px;margin-top:18px;padding:10px 13px;border-radius:12px;background:#100d1dcc;border:1px solid #ffffff1c;color:#e1d7f2}
.section-title{display:flex;align-items:end;justify-content:space-between;margin:30px 2px 14px}.section-title h2{margin:0;font-size:23px}.small{font-size:12px;color:var(--muted)}
.games{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card{position:relative;overflow:hidden;background:linear-gradient(155deg,#211c35,#12101d);border:1px solid var(--line);border-radius:20px;padding:19px;min-height:190px;transition:transform .18s,border-color .18s,box-shadow .18s}.card:hover{transform:translateY(-3px);border-color:#7655a9;box-shadow:0 12px 30px #0005}.game-icon{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;font-size:29px;background:linear-gradient(135deg,#49316b,#251b3c);border:1px solid #7653a344}.card h3{margin:13px 0 4px;font-size:18px}.card p{font-size:13px;min-height:38px}
button{border:0;border-radius:12px;padding:11px 16px;background:linear-gradient(105deg,#8654f6,#bd58dc);color:white;font-weight:850;cursor:pointer;font-size:14px;box-shadow:0 5px 18px #8b5cf633}button:active{transform:scale(.98)}button:disabled{opacity:.45;cursor:not-allowed}.secondary{background:#302744;border:1px solid #51416c;box-shadow:none}
.gamebox{display:none;margin-top:18px;background:linear-gradient(150deg,#171326,#0f0d19);border:1px solid #51416c;border-radius:22px;padding:clamp(18px,4vw,28px);text-align:center;box-shadow:0 16px 45px #0005}.gamebox.active{display:block}.gamebox h2{margin:0 0 5px}.gamebox.theme-moon{background:radial-gradient(ellipse at top,#263d79 0,#12182e 58%,#0b1020 100%);border-color:#648bff;box-shadow:0 16px 45px #315bff33}.gamebox.theme-candy{background:radial-gradient(ellipse at top,#79345d 0,#32172f 58%,#1b1022 100%);border-color:#ff83c7;box-shadow:0 16px 45px #ff58b633}.gamebox.theme-dragon{background:radial-gradient(ellipse at top,#6b4a16 0,#2e2415 58%,#15130e 100%);border-color:#e8b84d;box-shadow:0 16px 45px #e8a82f33}.gamebox.theme-moon button{background:linear-gradient(105deg,#3867db,#744fe5)}.gamebox.theme-candy button{background:linear-gradient(105deg,#e83e91,#ff8b62)}.gamebox.theme-dragon button{background:linear-gradient(105deg,#987020,#d9a93f);color:#211707}.gamebox.theme-moon .result{color:#b9d0ff}.gamebox.theme-candy .result{color:#ffc0e1}.gamebox.theme-dragon .result{color:#ffe3a0}.reels{font-size:clamp(42px,9vw,66px);letter-spacing:8px;margin:15px}.result{font-weight:850;min-height:28px;color:#e9d5ff;margin-top:12px}.wheel{width:190px;height:190px;border-radius:50%;margin:18px auto;background:conic-gradient(#8b5cf6 0 45deg,#31204d 45deg 90deg,#d946ef 90deg 135deg,#31204d 135deg 180deg,#8b5cf6 180deg 225deg,#31204d 225deg 270deg,#d946ef 270deg 315deg,#31204d 315deg);border:8px solid #e9d5ff;display:grid;place-items:center;font-size:32px;box-shadow:0 0 35px #8b5cf655}
.reward{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer{text-align:center;padding:25px;color:var(--muted);font-size:12px}
@media(max-width:760px){.games{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:15px;min-height:180px}}
@media(max-width:480px){.games{grid-template-columns:1fr}.card{min-height:0}.card p{min-height:0}.hero{padding:24px}.section-title{align-items:start;flex-direction:column;gap:5px}header{padding:13px 4vw}}
</style>
</head>
<body>
<header><div class="logo">NEON<span>ARCADE</span></div><div class="balance">🪙 <span id="balance">1000</span> golds</div></header>
<main>
<section class="hero"><div class="eyebrow">Welcome to the arcade</div><h1>Play for fun.<br><span style="color:#d8b4fe">Collect golds.</span></h1><p>Try the mini-games, collect points and beat your own high score.</p><div class="notice">Demo game only · Golds have no cash value · No deposits, purchases, betting or cash-outs.</div></section>
<div class="section-title"><h2>Featured games</h2><span class="small">Choose a game to play</span></div>
<section class="games">
<article class="card"><div class="game-icon">🎰</div><h3>Lucky Reels</h3><p>Spin three reels for a random arcade score.</p><button onclick="openGame('slots')">Play Lucky Reels</button></article>
<article class="card"><div class="game-icon">🎡</div><h3>Prize Wheel</h3><p>Give the wheel a spin and earn a random gold bonus.</p><button onclick="openGame('wheel')">Spin the Wheel</button></article>
<article class="card"><div class="game-icon">🃏</div><h3>Blackjack</h3><p>Play a simple card challenge and aim for 21. No bets.</p><button onclick="openGame('blackjack')">Play Blackjack</button></article>
<article class="card"><div class="game-icon">💎</div><h3>Mines Puzzle</h3><p>Find hidden gems on a grid and avoid the hidden traps. No stakes.</p><button onclick="openGame('mines')">Play Mines</button></article>
<article class="card"><div class="game-icon">🔺</div><h3>Plinko</h3><p>Drop a ball and collect an arcade score.</p><button onclick="openGame('plinko')">Play Plinko</button></article>
<article class="card"><div class="game-icon">🎲</div><h3>Dice Dash</h3><p>Roll two dice and try to beat your best score.</p><button onclick="openGame('dice')">Play Dice Dash</button></article>
<article class="card"><div class="game-icon">🧠</div><h3>Memory Match</h3><p>Flip tiles and find all matching pairs.</p><button onclick="openGame('memory')">Play Memory</button></article>
<article class="card"><div class="game-icon">⚡</div><h3>Reaction Rush</h3><p>Tap when the signal turns green and test your reaction.</p><button onclick="openGame('reaction')">Play Reaction Rush</button></article>
<article class="card"><div class="game-icon">🎁</div><h3>Daily Bonus</h3><p>Claim a small free virtual-gold reward once per visit.</p><button id="daily" onclick="claimDaily()">Claim 100 golds</button></article>
</section>
<div class="section-title"><h2>The Lot</h2><span class="small">More themed reel games · free play</span></div>
<section class="games">
<article class="card"><div class="game-icon">🌙</div><h3>Moonlight Spins</h3><p>A moon-and-stars themed reel game.</p><button onclick="openSlotTheme('Moonlight Spins',['🌙','⭐','☁️','✨','🪐','🌌'])">Play</button></article>
<article class="card"><div class="game-icon">🍭</div><h3>Candy Pop</h3><p>Bright candy symbols and arcade points.</p><button onclick="openSlotTheme('Candy Pop',['🍭','🍬','🍓','🍋','🍇','🍒'])">Play</button></article>
<article class="card"><div class="game-icon">🐉</div><h3>Dragon Treasure</h3><p>A fantasy-themed matching challenge.</p><button onclick="openSlotTheme('Dragon Treasure',['🐉','💎','🔥','👑','🗝️','🏰'])">Play</button></article>
</section>
<section id="slots" class="gamebox"><h2>🎰 Lucky Reels</h2><p>Free play. Match symbols to earn an arcade score.</p><div class="reels" id="reels">🍒 ⭐ 🍋</div><button onclick="spinSlots()">Spin reels</button><div class="result" id="slotResult"></div></section>
<section id="wheel" class="gamebox"><h2>🎡 Prize Wheel</h2><p>Free spin for an arcade score. No coins are spent.</p><div class="wheel">★</div><button onclick="spinWheel()">Spin wheel</button><div class="result" id="wheelResult"></div></section>
<section id="blackjack" class="gamebox"><h2>🃏 Blackjack Challenge</h2><p>Try to get as close to 21 as possible without going over. This is a score-only card game.</p><div class="result" id="bjCards">Press Deal to start.</div><button onclick="dealBlackjack()">Deal</button> <button class="secondary" onclick="hitBlackjack()">Hit</button> <button class="secondary" onclick="standBlackjack()">Stand</button><div class="result" id="bjResult"></div></section>
<section id="mines" class="gamebox"><h2>💎 Mines Puzzle</h2><p>Find all 5 gems hidden in the 5×5 grid. Avoid the harmless puzzle traps. Reset anytime.</p><div id="mineGrid" style="display:grid;grid-template-columns:repeat(5,minmax(42px,1fr));gap:7px;max-width:360px;margin:18px auto"></div><button class="secondary" onclick="newMines()">New puzzle</button><div class="result" id="mineResult"></div></section>
<section id="plinko" class="gamebox"><h2>🔺 Plinko</h2><p>Drop a ball to earn a random arcade score. No coins are spent.</p><div class="reels" id="plinkoBall">🔴</div><button onclick="dropPlinko()">Drop ball</button><div class="result" id="plinkoResult"></div></section>
<section id="dice" class="gamebox"><h2>🎲 Dice Dash</h2><p>Roll two dice. Your total adds to your arcade score.</p><div class="reels" id="diceFaces">🎲 🎲</div><button onclick="rollDice()">Roll dice</button><div class="result" id="diceResult"></div></section>
<section id="memory" class="gamebox"><h2>🧠 Memory Match</h2><p>Find all 4 matching pairs. Tap two tiles at a time.</p><div id="memoryGrid" style="display:grid;grid-template-columns:repeat(4,minmax(48px,1fr));gap:8px;max-width:360px;margin:18px auto"></div><button class="secondary" onclick="newMemory()">New game</button><div class="result" id="memoryResult"></div></section>
<section id="reaction" class="gamebox"><h2>⚡ Reaction Rush</h2><p>Press Start, wait for green, then tap as quickly as you can.</p><button id="reactionButton" onclick="reactionStart()">Start</button><div id="reactionDisplay" class="result">Ready?</div></section>
<section id="thelot" class="gamebox"><h2 id="themeTitle">The Lot</h2><p>Free themed reel challenge. Match symbols to earn a score.</p><div class="reels" id="themeReels">🌙 ⭐ ✨</div><button onclick="spinTheme()">Spin reels</button><div class="result" id="themeResult"></div></section>
</main>
<footer>NEON ARCADE · A fictional virtual-coin game prototype. No real-money gambling.</footer>
<script>
let coins=1000;const symbols=['🍒','⭐','🍋','🔔','💎','🍇'];
function update(){document.getElementById('balance').textContent=coins}
function openGame(id){document.querySelectorAll('.gamebox').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.getElementById(id).scrollIntoView({behavior:'smooth',block:'center'})}
function spinSlots(){let a=Array.from({length:3},()=>symbols[Math.floor(Math.random()*symbols.length)]);document.getElementById('reels').textContent=a.join(' ');let score=a.every(x=>x===a[0])?100:a[0]===a[1]||a[1]===a[2]?25:5;coins+=score;update();document.getElementById('slotResult').textContent='Arcade score: +'+score+' golds!'}
function spinWheel(){let prize=[5,10,20,30,50][Math.floor(Math.random()*5)];coins+=prize;update();document.getElementById('wheelResult').textContent='Arcade score: +'+prize+' golds!'}
let themeSymbols=symbols;
function openSlotTheme(title,items){
themeSymbols=items;
const box=document.getElementById('thelot');
box.classList.remove('theme-moon','theme-candy','theme-dragon');
const theme=title==='Moonlight Spins'?'theme-moon':title==='Candy Pop'?'theme-candy':'theme-dragon';
box.classList.add(theme);
document.getElementById('themeTitle').textContent=title;
document.querySelectorAll('.gamebox').forEach(x=>x.classList.remove('active'));
box.classList.add('active');
box.scrollIntoView({behavior:'smooth',block:'center'});
document.getElementById('themeReels').textContent=items.slice(0,3).join(' ');
document.getElementById('themeResult').textContent='Ready to play!';
}
function spinTheme(){let a=Array.from({length:3},()=>themeSymbols[Math.floor(Math.random()*themeSymbols.length)]);document.getElementById('themeReels').textContent=a.join(' ');let score=a.every(x=>x===a[0])?60:a[0]===a[1]||a[1]===a[2]?20:5;coins+=score;update();document.getElementById('themeResult').textContent='Arcade score: +'+score+' golds!'}
let bjPlayer=[],bjDealer=[],bjDone=true;
function card(){return Math.floor(Math.random()*13)+1}
function total(hand){return hand.reduce((s,c)=>s+(c>10?10:c),0)}
function dealBlackjack(){bjPlayer=[card(),card()];bjDealer=[card(),card()];bjDone=false;showBJ();document.getElementById('bjResult').textContent='Your turn.'}
function showBJ(){document.getElementById('bjCards').textContent='You: '+bjPlayer.map(c=>c>10?({11:'J',12:'Q',13:'K'}[c]):c).join(' · ')+' (total '+total(bjPlayer)+')  |  Dealer: '+bjDealer[0]+' · ?'}
function hitBlackjack(){if(bjDone||!bjPlayer.length)return;bjPlayer.push(card());showBJ();if(total(bjPlayer)>21){bjDone=true;document.getElementById('bjResult').textContent='Bust! Start a new round.'}}
function standBlackjack(){if(bjDone||!bjPlayer.length)return;while(total(bjDealer)<17)bjDealer.push(card());bjDone=true;let a=total(bjPlayer),b=total(bjDealer);document.getElementById('bjCards').textContent='You: '+a+' | Dealer: '+b;let msg=a>21?'Bust — dealer wins this round.':b>21||a>b?'You win the round!':a===b?'Tie game.':'Dealer wins this round.';document.getElementById('bjResult').textContent=msg}
let mineSet=new Set(),mineFound=0,mineOver=false;
function newMines(){mineSet=new Set();while(mineSet.size<5)mineSet.add(Math.floor(Math.random()*25));mineFound=0;mineOver=false;drawMines();document.getElementById('mineResult').textContent='Find all 5 gems.'}
function drawMines(){let g=document.getElementById('mineGrid');g.innerHTML='';for(let i=0;i<25;i++){let b=document.createElement('button');b.className='secondary';b.textContent='?';b.style.padding='12px 4px';b.disabled=mineOver;b.onclick=()=>{if(mineSet.has(i)){b.textContent='💎';b.disabled=true;mineFound++;if(mineFound===5){mineOver=true;document.getElementById('mineResult').textContent='Puzzle complete! +50 golds.';coins+=50;update()}}else{b.textContent='✦';b.disabled=true;document.getElementById('mineResult').textContent='Empty tile — keep looking!'} };g.appendChild(b)}}
function dropPlinko(){let score=[5,10,15,20,30,50][Math.floor(Math.random()*6)];document.getElementById('plinkoBall').textContent='🔴 ⬇️';coins+=score;update();document.getElementById('plinkoResult').textContent='The ball landed in a +'+score+' score slot!'}
function rollDice(){let a=1+Math.floor(Math.random()*6),b=1+Math.floor(Math.random()*6);document.getElementById('diceFaces').textContent=['⚀','⚁','⚂','⚃','⚄','⚅'][a-1]+' '+['⚀','⚁','⚂','⚃','⚄','⚅'][b-1];let score=a+b;coins+=score;update();document.getElementById('diceResult').textContent='You rolled '+score+' and earned '+score+' golds.'}
let memValues=[],memOpen=[],memMatched=[];
function newMemory(){memValues=['🍒','🍒','⭐','⭐','💎','💎','🍋','🍋'].sort(()=>Math.random()-.5);memOpen=[];memMatched=[];drawMemory();document.getElementById('memoryResult').textContent='Find all the pairs.'}
function drawMemory(){let grid=document.getElementById('memoryGrid');grid.innerHTML='';memValues.forEach((v,i)=>{let b=document.createElement('button');b.className='secondary';b.style.padding='14px 3px';b.textContent=memMatched.includes(i)||memOpen.includes(i)?v:'?';b.disabled=memMatched.includes(i)||memOpen.includes(i)||memOpen.length===2;b.onclick=()=>{memOpen.push(i);drawMemory();if(memOpen.length===2){if(memValues[memOpen[0]]===memValues[memOpen[1]]){memMatched.push(...memOpen);memOpen=[];drawMemory();if(memMatched.length===8){coins+=40;update();document.getElementById('memoryResult').textContent='All pairs found! +40 golds.'}}else{setTimeout(()=>{memOpen=[];drawMemory()},700)}}};grid.appendChild(b)})}
newMemory();
let reactionTimer=null,reactionStartAt=0,reactionReady=false;
function reactionStart(){clearTimeout(reactionTimer);reactionReady=false;let b=document.getElementById('reactionButton');b.textContent='Wait...';b.style.background='#9b354e';document.getElementById('reactionDisplay').textContent='Wait for green...';reactionTimer=setTimeout(()=>{reactionReady=true;reactionStartAt=Date.now();b.textContent='TAP NOW';b.style.background='#16834b';document.getElementById('reactionDisplay').textContent='GO!'},1200+Math.random()*2800);b.onclick=()=>{if(!reactionReady){clearTimeout(reactionTimer);document.getElementById('reactionDisplay').textContent='Too early! Try again.';b.textContent='Try again';b.style.background='';b.onclick=reactionStart;return}let ms=Date.now()-reactionStartAt;let score=Math.max(1,Math.round(1000/ms));coins+=score;update();reactionReady=false;document.getElementById('reactionDisplay').textContent='Your reaction: '+ms+' ms · +'+score+' golds';b.textContent='Play again';b.style.background='';b.onclick=reactionStart}}
newMines();
function claimDaily(){coins+=100;update();let b=document.getElementById('daily');b.disabled=true;b.textContent='Bonus claimed';}
update();
</script>
</body>
</html>
